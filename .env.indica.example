# Indica Anime Us environment example
# Leave cloud provider keys blank to use local/offline features only.
INDICA_MODE=offline
INDICA_WORKSPACE=./workspace
INDICA_MAX_UPLOAD_MB=100
INDICA_MAX_PDF_PAGES=300
INDICA_ALLOW_CLOUD_PROVIDERS=false
INDICA_ALLOW_TELEMETRY=false

# Optional localhost endpoints (loopback only in strict offline mode)
INDICA_OLLAMA_BASE_URL=http://127.0.0.1:11434
INDICA_COMFYUI_BASE_URL=http://127.0.0.1:8188

# Configure cloud API credentials only in server-only settings or OS keychain.
# Never use NEXT_PUBLIC_ variables for secrets.
