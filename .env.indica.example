# Indica Anime Us — local-first default
INDICA_MODE=offline
INDICA_WORKSPACE=./workspace
INDICA_MAX_UPLOAD_MB=100
INDICA_MAX_PDF_PAGES=300
INDICA_ALLOW_CLOUD_PROVIDERS=false
INDICA_ALLOW_TELEMETRY=false

# Optional localhost engines, unused until explicitly enabled
INDICA_OLLAMA_BASE_URL=http://127.0.0.1:11434
INDICA_COMFYUI_BASE_URL=http://127.0.0.1:8188

# Configure cloud credentials only in server-only settings or OS keychain.
# Never put secrets in NEXT_PUBLIC_* variables.
